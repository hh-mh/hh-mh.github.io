 RowBox[{
  RowBox[{"epsilon", "=", "0.001"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"While", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"b", "-", "a"}], ">", "epsilon"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"c", "=", 
      RowBox[{"0.5", "*", 
       RowBox[{"(", 
        RowBox[{"a", "+", "b"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
