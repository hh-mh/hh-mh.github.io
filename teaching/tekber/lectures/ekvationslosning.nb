4957173ec6f4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Remove", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"x", "^", "3"}], "-", 
    RowBox[{"4", 
     RowBox[{"x", "^", "2"}]}], "+", 
    RowBox[{"4", "x"}], "+", "1"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"g", "[", "1", "]"}], "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "/", "4"}], ")"}], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"x", "^", "3"}]}], "+", 
      RowBox[{"4", 
       RowBox[{"x", "^", "2"}]}], "-", "1"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"g", "[", "2", "]"}], "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"-", "1"}], "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"x", "^", "2"}], "-", 
      RowBox[{"4", "x"}], "+", "4"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"g", "[", "3", "]"}], "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{"1", "/", "2"}], ")"}]}], "*", 
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{"x", "^", "3"}], "+", 
      RowBox[{"4", "x"}], "+", "1"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"epsilon", "=", "0.000001"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"diff", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", 
   RowBox[{"i", "\[LessEqual]", "3"}], ",", 
   RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"xold", "[", "i", "]"}], "=", 
     RowBox[{"-", "0.2"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"k", "=", "1"}], ";", "\[IndentingNewLine]", 
    RowBox[{"While", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"diff", ">", "epsilon"}], "&&", 
       RowBox[{"k", "<", "30"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"xnew", "[", "i", "]"}], "=", 
        RowBox[{
         RowBox[{"g", "[", "i", "]"}], "[", 
         RowBox[{"xold", "[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"diff", "=", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"xnew", "[", "i", "]"}], "-", 
          RowBox[{"xold", "[", "i", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"xold", "[", "i", "]"}], "=", 
        RowBox[{"xnew", "[", "i", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"++", "k"}]}]}], "\[IndentingNewLine]", "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"diff", "=", "1"}], ";"}]}], "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<g[1] = \>\"", ",", 
    RowBox[{
     RowBox[{"g", "[", "1", "]"}], "[", 
     RowBox[{"xnew", "[", "1", "]"}], "]"}], ",", "\"\<, g[2] = \>\"", ",", 
    RowBox[{
     RowBox[{"g", "[", "2", "]"}], "[", 
     RowBox[{"xnew", "[", "2", "]"}], "]"}], ",", "\"\<, g[3] = \>\"", ",", 
    RowBox[{
     RowBox[{"g", "[", "3", "]"}], "[", 
     RowBox[{"xnew", "[", "3", "]"}], "]"}]}], "]"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Kontroll", " ", "med", " ", "NSolve"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"NSolve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", "x", "]"}], "\[Equal]", "0"}], ",", "x", ",", "Reals"}],
   "]"}]}], "Input",
